# Copy to .env and fill ONE of the API options. run.sh loads it automatically.
# Failover order: Anthropic -> OpenAI-compatible (Groq/OpenAI) -> local Ollama -> deterministic rules.

# Option A, Claude (best tool-calling)
# ANTHROPIC_API_KEY=sk-ant-...
# FLEET_CLAUDE_MODEL=claude-haiku-5-5

# Option B, Groq (free key at console.groq.com, very fast, OpenAI-compatible)
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# Option C, local Ollama (offline fallback; runs on the RTX GPU)
# WSL in NAT mode can't use localhost for Windows apps: use the Windows host IP
#   (in WSL: ip route show default | awk '{print $3}') and set OLLAMA_HOST=0.0.0.0 on Windows.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
FLEET_LLM_PROVIDER=auto

# AgOpenWeb / AgOpenGPS digital twin (tractor T1 mirrors a real AgOpenWeb instance)
# FLEET_AGOPENWEB=ws://localhost:5174/ws
# FLEET_AGOPENWEB_TRACTOR=T1

# Public URL for the judges' QR code (cloudflared tunnel)
# PUBLIC_URL=https://xxxx.trycloudflare.com
